# =============================================================================
# BACKEND - Variáveis de Ambiente (Configuração para Camadas 100% Gratuitas)
# =============================================================================

# Porta do Servidor Express (No Render, a porta é injetada automaticamente via process.env.PORT)
PORT=3333
NODE_ENV=production

# -----------------------------------------------------------------------------
# 1. Banco de Dados PostgreSQL Gratuito (Neon Serverless ou Supabase Free)
# Exemplo Neon: postgresql://[user]:[password]@[host]/[database]?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:sua-senha-neon@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# 2. Segurança e Sessão Persistente (JWT + Captcha HMAC)
# Dica: gere strings aleatórias seguras no terminal com: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET="gere-uma-chave-secreta-forte-com-mais-de-32-caracteres"
JWT_EXPIRES_IN="30d"
CAPTCHA_SECRET="gere-outro-segredo-hmac-para-o-captcha-32-chars"

# -----------------------------------------------------------------------------
# 3. URL do Frontend para CORS (Vercel ou Netlify)
# Aceita uma ou mais URLs separadas por vírgula (ex: https://meu-app.vercel.app,http://localhost:5173)
# -----------------------------------------------------------------------------
FRONTEND_URL="https://seu-pwa.vercel.app"

# -----------------------------------------------------------------------------
# 4. Google Gemini API (Camada Gratuita - Assistente / Amigo Virtual)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
# Dica: se deixada vazia, o assistente ativa automaticamente o fallback empático local!
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
DAILY_CHAT_TOKEN_LIMIT=12000

# -----------------------------------------------------------------------------
# 5. Resend (Envio de E-mails de Recuperação de Senha - Gratuito até 3.000 emails/mês)
# Obtenha sua chave em: https://resend.com/
# Dica: se deixada vazia em desenvolvimento, o link de redefinição é exibido nos logs do console.
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Respira PWA <onboarding@resend.dev>"
