PORT=3333
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://calm_user:calm_password@localhost:5432/calm_pwa?schema=public"

# JWT (Sessão Persistente)
JWT_SECRET="substitua-por-uma-chave-secreta-forte-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="30d"

# Segredo HMAC para o desafio Anti-Robô integrado
CAPTCHA_SECRET="substitua-por-outro-segredo-hmac-para-captcha-32-chars"

# URL do Frontend (usada no CORS e no link de recuperação de senha)
FRONTEND_URL="http://localhost:5173"

# Resend (Envio de e-mails de recuperação de senha)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Respira PWA <onboarding@resend.dev>"

# Jamendo API v3 (https://developer.jamendo.com/)
JAMENDO_CLIENT_ID="seu-client-id-jamendo"
