# =============================================================================
# Variáveis de Ambiente e Segredos (NUNCA versionar chaves reais)
# =============================================================================
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Certificados, chaves privadas e credenciais
*.pem
*.key
*.crt
*.p12
*.pfx
*credentials*.json
*service-account*.json

# =============================================================================
# Dependências e Builds
# =============================================================================
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
frontend/dev-dist/
.prisma/
**/.prisma/
*.tsbuildinfo
**/*.tsbuildinfo

# =============================================================================
# Bancos locais, Logs e Arquivos Temporários / Uploads de Áudio
# =============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/prisma/*.db
backend/prisma/*.db-journal
*.sqlite
*.sqlite3
uploads/
**/uploads/
tmp/
**/tmp/
temp/
**/temp/
*.webm
*.ogg
*.wav
!frontend/public/audio/**

# Sistema Operacional / IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
